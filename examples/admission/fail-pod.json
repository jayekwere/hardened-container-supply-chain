{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "unsigned-example",
    "namespace": "signature-demo"
  },
  "spec": {
    "automountServiceAccountToken": false,
    "schedulingGates": [
      {
        "name": "hsc.test/admission-only"
      }
    ],
    "securityContext": {
      "runAsNonRoot": true,
      "runAsUser": 65532,
      "runAsGroup": 65532,
      "seccompProfile": {
        "type": "RuntimeDefault"
      }
    },
    "containers": [
      {
        "name": "service",
        "image": "ghcr.io/jayekwere/hardened-container-supply-chain@sha256:6d97b57f4b1757a41321b49e1a8afd19d5012a80c09688982d844fa01b1b206c",
        "securityContext": {
          "allowPrivilegeEscalation": false,
          "readOnlyRootFilesystem": true,
          "capabilities": {
            "drop": [
              "ALL"
            ]
          }
        },
        "resources": {
          "limits": {
            "cpu": "100m",
            "memory": "32Mi"
          }
        }
      }
    ]
  }
}
