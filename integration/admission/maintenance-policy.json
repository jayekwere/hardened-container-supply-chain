{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "admissionregistration.k8s.io/v1",
      "kind": "ValidatingAdmissionPolicy",
      "metadata": {
        "name": "hsc-maintenance"
      },
      "spec": {
        "failurePolicy": "Fail",
        "matchConstraints": {
          "resourceRules": [
            {
              "apiGroups": [
                ""
              ],
              "apiVersions": [
                "v1"
              ],
              "operations": [
                "CREATE",
                "UPDATE"
              ],
              "resources": [
                "pods",
                "pods/ephemeralcontainers",
                "pods/resize",
                "replicationcontrollers",
                "replicationcontrollers/scale"
              ],
              "scope": "Namespaced"
            },
            {
              "apiGroups": [
                "apps"
              ],
              "apiVersions": [
                "v1"
              ],
              "operations": [
                "CREATE",
                "UPDATE"
              ],
              "resources": [
                "deployments",
                "deployments/scale",
                "statefulsets",
                "statefulsets/scale",
                "daemonsets",
                "replicasets",
                "replicasets/scale"
              ],
              "scope": "Namespaced"
            },
            {
              "apiGroups": [
                "batch"
              ],
              "apiVersions": [
                "v1"
              ],
              "operations": [
                "CREATE",
                "UPDATE"
              ],
              "resources": [
                "jobs",
                "cronjobs"
              ],
              "scope": "Namespaced"
            }
          ]
        },
        "validations": [
          {
            "expression": "false",
            "message": "HSC-MAINTENANCE: workload writes are paused for an administrator-controlled trust update",
            "reason": "Forbidden"
          }
        ]
      }
    },
    {
      "apiVersion": "admissionregistration.k8s.io/v1",
      "kind": "ValidatingAdmissionPolicyBinding",
      "metadata": {
        "name": "hsc-maintenance"
      },
      "spec": {
        "policyName": "hsc-maintenance",
        "validationActions": [
          "Deny"
        ],
        "matchResources": {
          "namespaceSelector": {
            "matchLabels": {
              "supply-chain.example.invalid/maintenance": "locked"
            }
          }
        }
      }
    }
  ]
}
