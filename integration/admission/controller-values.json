    "resources": {
      "requests": {
        "cpu": "100m",
        "memory": "128Mi"
      },
      "limits": {
        "cpu": "500m",
        "memory": "512Mi"
      }
    }
  },
  "cosign": {
    "webhookTimeoutSeconds": {
      "mutating": 20,
      "validating": 20
    }
  },
  "leasescleanup": {
    "image": {
      "repository": "registry.k8s.io/kubectl",
      "version": "sha256:497d298f891edb7608dfce9dae4bb08dffc4ddcd7f5d24a0512d4bbf33e04f26"
    }
  }
}
