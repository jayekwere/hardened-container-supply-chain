+	admissionv1 "k8s.io/api/admission/v1"
+	apixv1 "k8s.io/apiextensions-apiserver/pkg/apis/apiextensions/v1"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"knative.dev/pkg/apis"
+	"knative.dev/pkg/logging"
+	knativewebhook "knative.dev/pkg/webhook"
+)
+
+const admissionBodyCap = 3 * 1024 * 1024
+
+type bodyLimitAdmission struct {
+	path, reread string
+	calls        int
+	deny         bool
+}
+
+func (c *bodyLimitAdmission) Path() string { return c.path }
+func (c *bodyLimitAdmission) Admit(ctx context.Context, r *admissionv1.AdmissionRequest) *admissionv1.AdmissionResponse {
+	c.calls++
+	body, err := io.ReadAll(apis.GetHTTPRequest(ctx).Body)
+	if err != nil {
+		panic(err)
+	}
+	c.reread = string(body)
+	status := metav1.StatusSuccess
+	if c.deny {
+		status = metav1.StatusFailure
+	}
+	return &admissionv1.AdmissionResponse{Allowed: !c.deny, Result: &metav1.Status{Status: status}}
+}
+
+type bodyLimitConversion struct {
+	path  string
+	calls int
+	deny  bool
+}
+
+func (c *bodyLimitConversion) Path() string { return c.path }
+func (c *bodyLimitConversion) Convert(_ context.Context, r *apixv1.ConversionRequest) *apixv1.ConversionResponse {
+	c.calls++
+	status := metav1.StatusSuccess
+	if c.deny {
+		status = metav1.StatusFailure
+	}
+	return &apixv1.ConversionResponse{UID: r.UID, ConvertedObjects: r.Objects, Result: metav1.Status{Status: status}}
+}
+
+type bodyLimitReader struct {
+	io.Reader
+	bytes int
+}
+
+func (r *bodyLimitReader) Read(p []byte) (int, error) {
+	n, err := r.Reader.Read(p)
+	r.bytes += n
+	return n, err
+}
+
+// Exercise the actual shared server boundary and both decoding handlers. All
+// inputs stay below 3.2 MiB; this tests bounded reads without an OOM experiment.
+func TestAdmissionBodyLimit(t *testing.T) {
+	for _, route := range []string{"admission", "conversion"} {
+		t.Run(route, func(t *testing.T) {
