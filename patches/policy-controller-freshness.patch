+)
+
+func testLivePolicy(name string) *policyapi.ClusterImagePolicy {
+	p := &policyapi.ClusterImagePolicy{}
+	raw := `{"spec":{"images":[{"glob":"example.invalid/project@sha256:*"}],"authorities":[{"name":"deny","static":{"action":"fail"}}]}}`
+	if err := json.Unmarshal([]byte(raw), p); err != nil {
+		panic(err)
+	}
+	p.Name, p.UID, p.ResourceVersion = name, types.UID(name+"-uid"), "1"
+	return p
+}
+
+func TestPolicyFreshnessSnapshot(t *testing.T) {
+	a, b := testLivePolicy("release-signer"), testLivePolicy("release-attestations")
+	t.Run("replaces-poisoned-watcher", func(t *testing.T) {
+		ctx, _ := fakeclient.With(context.Background(), a, b)
+		poison := config.FromContextOrDefaults(ctx)
+		poison.ImagePolicyConfig.Policies["release-signer"] = webhookcip.ClusterImagePolicy{ResourceVersion: "old"}
+		ctx = config.ToContext(ctx, poison)
+		fresh, finish, err := freshPolicyContext(ctx)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if config.FromContext(fresh).ImagePolicyConfig.Policies["release-signer"].ResourceVersion != "1" {
+			t.Fatal("used stale watcher")
+		}
+		if poison.ImagePolicyConfig.Policies["release-signer"].ResourceVersion != "old" {
+			t.Fatal("mutated shared snapshot")
+		}
+		if err := finish(); err != nil {
+			t.Fatal(err)
+		}
+	})
+	for _, name := range []string{"release-signer", "release-attestations"} {
+		t.Run("missing-"+name, func(t *testing.T) {
+			other := a
+			if name == a.Name {
+				other = b
+			}
+			ctx, _ := fakeclient.With(context.Background(), other)
+			if _, _, err := freshPolicyContext(ctx); err == nil {
+				t.Fatal("missing mandatory policy accepted")
+			}
+		})
+	}
+	t.Run("api-error-before", func(t *testing.T) {
+		ctx, cs := fakeclient.With(context.Background(), a, b)
+		cs.PrependReactor("list", "clusterimagepolicies", func(ktesting.Action) (bool, runtime.Object, error) { return true, nil, errors.New("unavailable") })
+		if _, _, err := freshPolicyContext(ctx); err == nil {
+			t.Fatal("read error accepted")
+		}
+	})
+	t.Run("most-recent-unfiltered-list", func(t *testing.T) {
+		count := 0
+		server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			count++
+			if r.URL.RawQuery != "" {
+				t.Errorf("unsafe consistency/filter parameters: %s", r.URL.RawQuery)
+			}
+			if r.URL.Path != "/apis/policy.sigstore.dev/v1alpha1/clusterimagepolicies" {
+				t.Errorf("path %s", r.URL.Path)
+			}
+			w.Header().Set("Content-Type", "application/json")
+			_ = json.NewEncoder(w).Encode(&policyapi.ClusterImagePolicyList{TypeMeta: metav1.TypeMeta{APIVersion: "policy.sigstore.dev/v1alpha1", Kind: "ClusterImagePolicyList"}, Items: []policyapi.ClusterImagePolicy{*a, *b}})
+		}))
+		defer server.Close()
+		cs, err := clientset.NewForConfig(&rest.Config{Host: server.URL})
+		if err != nil {
+			t.Fatal(err)
+		}
+		ctx := context.WithValue(context.Background(), policyclient.Key{}, cs)
+		_, finish, err := freshPolicyContext(ctx)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err := finish(); err != nil {
+			t.Fatal(err)
+		}
+		if count != 2 {
+			t.Fatalf("want before+after reads, got %d", count)
+		}
+	})
+	for _, change := range []string{"spec", "create", "delete-recreate", "delete", "api-error", "spec-aba", "status-only"} {
+		t.Run("during-verification-"+change, func(t *testing.T) {
+			ctx, cs := fakeclient.With(context.Background(), a, b)
+			_, finish, err := freshPolicyContext(ctx)
+			if err != nil {
+				t.Fatal(err)
+			}
+			next := a.DeepCopy()
+			switch change {
+			case "spec":
+				next.Spec.Authorities[0].Static.Action = "pass"
+				_, err = cs.PolicyV1alpha1().ClusterImagePolicies().Update(ctx, next, metav1.UpdateOptions{})
+			case "create":
+				_, err = cs.PolicyV1alpha1().ClusterImagePolicies().Create(ctx, testLivePolicy("extra"), metav1.CreateOptions{})
+			case "delete-recreate":
+				err = cs.PolicyV1alpha1().ClusterImagePolicies().Delete(ctx, a.Name, metav1.DeleteOptions{})
+				next.UID = "new-uid"
+				_, err = cs.PolicyV1alpha1().ClusterImagePolicies().Create(ctx, next, metav1.CreateOptions{})
+			case "delete":
+				err = cs.PolicyV1alpha1().ClusterImagePolicies().Delete(ctx, a.Name, metav1.DeleteOptions{})
+			case "api-error":
+				cs.PrependReactor("list", "clusterimagepolicies", func(ktesting.Action) (bool, runtime.Object, error) { return true, nil, errors.New("unavailable") })
+			case "spec-aba":
+				next.Generation += 2
+				_, err = cs.PolicyV1alpha1().ClusterImagePolicies().Update(ctx, next, metav1.UpdateOptions{})
+			case "status-only":
+				next.ResourceVersion = "2"
+				_, err = cs.PolicyV1alpha1().ClusterImagePolicies().Update(ctx, next, metav1.UpdateOptions{})
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			result := finish()
+			if change == "status-only" {
+				if result != nil {
+					t.Fatal(result)
+				}
+				return
+			}
+			if result == nil || !strings.Contains(result.Error(), "TRUST-FRESHNESS") {
+				t.Fatalf("unsafe finish: %v", result)
+			}
+		})
+	}
+	for _, change := range []string{"deleting", "missing-uid", "warn", "secretRef", "kms", "configMapRef", "remote", "trustRootRef", "rfc3161timestamp"} {
+		t.Run("reject-"+change, func(t *testing.T) {
+			next := a.DeepCopy()
+			switch change {
+			case "deleting":
+				now := metav1.Now()
+				next.DeletionTimestamp = &now
+			case "missing-uid":
+				next.UID = ""
+			case "warn":
+				next.Spec.Mode = "warn"
+			default:
+				var data map[string]any
+				raw, _ := json.Marshal(next)
+				_ = json.Unmarshal(raw, &data)
+				spec := data["spec"].(map[string]any)
+				switch change {
+				case "secretRef":
+					spec["authorities"] = []any{map[string]any{"key": map[string]any{"secretRef": map[string]any{"name": "key"}}}}
+				case "kms":
+					spec["authorities"] = []any{map[string]any{"key": map[string]any{"kms": "test://key"}}}
+				case "configMapRef":
+					spec["policy"] = map[string]any{"configMapRef": map[string]any{"name": "rules"}}
+				case "remote":
+					spec["policy"] = map[string]any{"remote": map[string]any{"url": "https://example.invalid/rules", "sha256": strings.Repeat("0", 64)}}
+				case "trustRootRef":
+					spec["authorities"] = []any{map[string]any{"keyless": map[string]any{"trustRootRef": "custom"}}}
+				case "rfc3161timestamp":
+					spec["authorities"] = []any{map[string]any{"rfc3161timestamp": map[string]any{"trustRootRef": "custom"}}}
+				}
+				raw, _ = json.Marshal(data)
+				if err := json.Unmarshal(raw, next); err != nil {
+					t.Fatal(err)
+				}
+			}
+			ctx, _ := fakeclient.With(context.Background(), next, b)
+			if _, _, err := freshPolicyContext(ctx); err == nil {
+				t.Fatal("unsupported state accepted")
+			}
+		})
+	}
+}
+
+func TestPolicyFreshnessHTTPContext(t *testing.T) {
+	root, _ := fakeclient.With(context.Background(), testLivePolicy("release-signer"), testLivePolicy("release-attestations"))
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		ctx := WithAuthoritativePolicyClient(r.Context(), root)
+		_, finish, err := freshPolicyContext(ctx)
+		if err != nil {
+			http.Error(w, err.Error(), 500)
+			return
+		}
+		if err := finish(); err != nil {
+			http.Error(w, err.Error(), 500)
+			return
+		}
+		w.WriteHeader(204)
+	}))
+	defer server.Close()
+	response, err := http.Get(server.URL)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer response.Body.Close()
+	if response.StatusCode != 204 {
+		t.Fatalf("independent HTTP context failed: %d", response.StatusCode)
+	}
+}
+
+func TestPolicyFreshnessScaleDown(t *testing.T) {
+	before := []byte(`{"kind":"Deployment","metadata":{"name":"demo","generation":1,"resourceVersion":"3","labels":{"scope":"a"}},"spec":{"replicas":2,"template":{"spec":{"containers":[{"name":"service","image":"trusted"}]}}}}`)
+	for _, tc := range []struct {
+		name, after string
+		safe        bool
+	}{
+		{"replicas-only", `{"kind":"Deployment","metadata":{"name":"demo","generation":2,"resourceVersion":"4","labels":{"scope":"a"}},"spec":{"replicas":1,"template":{"spec":{"containers":[{"name":"service","image":"trusted"}]}}}}`, true},
+		{"image-change", `{"kind":"Deployment","metadata":{"name":"demo","generation":2,"resourceVersion":"4","labels":{"scope":"a"}},"spec":{"replicas":1,"template":{"spec":{"containers":[{"name":"service","image":"untrusted"}]}}}}`, false},
+		{"label-change", `{"kind":"Deployment","metadata":{"name":"demo","generation":2,"resourceVersion":"4","labels":{"scope":"b"}},"spec":{"replicas":1,"template":{"spec":{"containers":[{"name":"service","image":"trusted"}]}}}}`, false},
+		{"annotation-change", `{"kind":"Deployment","metadata":{"name":"demo","labels":{"scope":"a"},"annotations":{"bypass":"true"}},"spec":{"replicas":1,"template":{"spec":{"containers":[{"name":"service","image":"trusted"}]}}}}`, false},
+		{"other-spec-change", `{"kind":"Deployment","metadata":{"name":"demo","labels":{"scope":"a"}},"spec":{"replicas":1,"strategy":{"type":"Recreate"},"template":{"spec":{"containers":[{"name":"service","image":"trusted"}]}}}}`, false},
+		{"malformed", `{`, false},
+		{"missing-spec", `{"metadata":{"name":"demo"}}`, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := onlyReplicasChanged(before, []byte(tc.after)); got != tc.safe {
+				t.Fatalf("safe=%v want %v", got, tc.safe)
+			}
+		})
+	}
+}
