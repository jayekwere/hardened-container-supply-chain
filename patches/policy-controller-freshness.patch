+package webhook
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"io"
+	"reflect"
+	"sort"
+	"time"
+
+	"github.com/sigstore/policy-controller/pkg/apis/config"
+	policyapi "github.com/sigstore/policy-controller/pkg/apis/policy/v1alpha1"
+	policyclient "github.com/sigstore/policy-controller/pkg/client/injection/client"
+	webhookcip "github.com/sigstore/policy-controller/pkg/webhook/clusterimagepolicy"
+	admissionv1 "k8s.io/api/admission/v1"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"knative.dev/pkg/apis"
+)
+
+// freshPolicyContext bypasses the reconciled ConfigMap and process watcher.
+// MostRecent reads deliberately leave ResourceVersion, selectors and limits unset.
+// This dedicated build supports inline trust material and always denies no-match.
+func freshPolicyContext(ctx context.Context) (context.Context, func() *apis.FieldError, error) {
+	policies, token, err := readLivePolicies(ctx)
+	if err != nil {
+		return ctx, nil, err
+	}
+	previous := config.FromContextOrDefaults(ctx)
+	ctx = config.ToContext(ctx, &config.Config{ImagePolicyConfig: policies, SigstoreKeysConfig: previous.SigstoreKeysConfig})
+	finish := func() *apis.FieldError {
+		_, after, err := readLivePolicies(ctx)
+		if err != nil {
+			return freshnessError(err)
+		}
+		if after != token {
+			return freshnessError(fmt.Errorf("policy state changed during verification"))
+		}
+		return nil
+	}
+	return ctx, finish, nil
+}
+
+func freshnessError(err error) *apis.FieldError {
+	return apis.ErrGeneric("TRUST-FRESHNESS: "+err.Error(), apis.CurrentField)
+}
+
+func readLivePolicies(ctx context.Context) (*config.ImagePolicyConfig, string, error) {
+	readCtx, cancel := context.WithTimeout(ctx, 5*time.Second)
+	defer cancel()
+	list, err := policyclient.Get(ctx).PolicyV1alpha1().ClusterImagePolicies().List(readCtx, metav1.ListOptions{})
+	if err != nil {
+		return nil, "", fmt.Errorf("authoritative policy read failed: %w", err)
+	}
+	sort.Slice(list.Items, func(i, j int) bool { return list.Items[i].Name < list.Items[j].Name })
+	data := make(map[string]string, len(list.Items))
+	type state struct {
+		Name, UID  string
+		Generation int64
+		Spec       policyapi.ClusterImagePolicySpec
+	}
+	states := make([]state, 0, len(list.Items))
+	for _, p := range list.Items {
+		if p.UID == "" || p.DeletionTimestamp != nil {
+			return nil, "", fmt.Errorf("policy %s missing identity or being deleted", p.Name)
+		}
+		if p.Spec.Mode != "" && p.Spec.Mode != "enforce" {
+			return nil, "", fmt.Errorf("policy %s must enforce", p.Name)
+		}
+		raw, err := json.Marshal(p.Spec)
+		if err != nil {
+			return nil, "", err
+		}
+		var spec any
+		if err := json.Unmarshal(raw, &spec); err != nil {
+			return nil, "", err
+		}
+		if field := externalPolicyReference(spec); field != "" {
+			return nil, "", fmt.Errorf("policy %s has unsupported external reference %s", p.Name, field)
+		}
+		converted := webhookcip.ConvertClusterImagePolicyV1alpha1ToWebhook(&p)
+		raw, err = json.Marshal(converted)
+		if err != nil {
+			return nil, "", err
+		}
+		data[p.Name] = string(raw)
+		states = append(states, state{Name: p.Name, UID: string(p.UID), Generation: p.Generation, Spec: p.Spec})
+	}
+	for _, required := range []string{"release-signer", "release-attestations"} {
+		if _, ok := data[required]; !ok {
+			return nil, "", fmt.Errorf("mandatory policy %s is absent", required)
+		}
+	}
+	policies, err := config.NewImagePoliciesConfigFromMap(data)
+	if err != nil {
+		return nil, "", fmt.Errorf("live policy conversion failed: %w", err)
+	}
+	raw, err := json.Marshal(states)
+	if err != nil {
+		return nil, "", err
+	}
+	sum := sha256.Sum256(raw)
+	return policies, hex.EncodeToString(sum[:]), nil
+}
+
+// References would reintroduce mutable copies outside the authoritative CIP read.
+// Reject them explicitly instead of silently dropping or using cached material.
+func externalPolicyReference(value any) string {
+	switch value := value.(type) {
+	case map[string]any:
+		for key, child := range value {
+			switch key {
+			case "secretRef", "kms", "configMapRef", "remote", "trustRootRef", "rfc3161timestamp":
+				if child != nil && child != "" {
+					return key
+				}
+			}
+			if found := externalPolicyReference(child); found != "" {
+				return found
+			}
+		}
+	case []any:
+		for _, child := range value {
+			if found := externalPolicyReference(child); found != "" {
+				return found
+			}
+		}
+	}
+	return ""
+}
+
+// WithAuthoritativePolicyClient carries the server's client into an independent
+// HTTP admission context without trusting a client already attached by a caller.
+func WithAuthoritativePolicyClient(request, server context.Context) context.Context {
+	return context.WithValue(request, policyclient.Key{}, policyclient.Get(server))
+}
+
+func scaleDownOnly(ctx context.Context) bool {
+	r := apis.GetHTTPRequest(ctx)
+	if r == nil || r.Body == nil {
+		return false
+	}
+	raw, err := io.ReadAll(r.Body)
+	r.Body = io.NopCloser(bytes.NewReader(raw))
+	if err != nil {
+		return false
+	}
+	var review admissionv1.AdmissionReview
+	if json.Unmarshal(raw, &review) != nil || review.Request == nil {
+		return false
+	}
+	return onlyReplicasChanged(review.Request.OldObject.Raw, review.Request.Object.Raw)
+}
+
+func onlyReplicasChanged(before, after []byte) bool {
+	var old, next map[string]any
+	if json.Unmarshal(before, &old) != nil || json.Unmarshal(after, &next) != nil {
+		return false
+	}
+	for _, object := range []map[string]any{old, next} {
+		spec, ok := object["spec"].(map[string]any)
+		if !ok {
+			return false
+		}
+		delete(spec, "replicas")
+		metadata, ok := object["metadata"].(map[string]any)
+		if !ok {
+			return false
+		}
+		for _, key := range []string{"generation", "resourceVersion", "managedFields"} {
+			delete(metadata, key)
+		}
+		delete(object, "status")
+	}
+	return reflect.DeepEqual(old, next)
+}
