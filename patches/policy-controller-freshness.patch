+	clientset "github.com/sigstore/policy-controller/pkg/client/clientset/versioned"
+	policyclient "github.com/sigstore/policy-controller/pkg/client/injection/client"
+	fakeclient "github.com/sigstore/policy-controller/pkg/client/injection/client/fake"
+	webhookcip "github.com/sigstore/policy-controller/pkg/webhook/clusterimagepolicy"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
